# Ejemplo de Configuración - NO USAR EN PRODUCCIÓN
# Copia este archivo a .env.local y actualiza con tus valores reales

# ==============================================================================
# CONFIGURACIÓN DEL BACKEND
# ==============================================================================

# URL de tu API Backend
# Por defecto, el backend corre en el puerto 3000
# Si tu backend está en otro puerto o dominio, cámbialo aquí
NEXT_PUBLIC_API_URL=https://hoyt-uncautious-jonnie.ngrok-free.dev


# ==============================================================================
# CONFIGURACIÓN DE GOOGLE FORMS
# ==============================================================================

# URL base de tu formulario de Google Forms
#
# PASOS PARA OBTENERLA:
# 1. Ve a https://forms.google.com
# 2. Abre tu formulario de carga de documentos
# 3. Haz clic en "Enviar" (arriba a la derecha)
# 4. Copia el enlace
# 5. La URL base termina en "/viewform"
#
# EJEMPLO:
# https://docs.google.com/forms/d/e/1FAIpQLSfXXXXXXXXXXXXXXXXXXXXXXXX/viewform
#
# NOTA: NO incluyas parámetros (?entry.xxx=yyy) aquí
NEXT_PUBLIC_GOOGLE_FORMS_URL=https://docs.google.com/forms/d/e/TU_FORM_ID/viewform


# ==============================================================================
# INSTRUCCIONES PARA ENTRY IDS
# ==============================================================================

# Los Entry IDs NO se configuran aquí, se configuran en lib/api.ts
#
# PASOS PARA OBTENER LOS ENTRY IDS:
# 1. Abre tu formulario en modo edición
# 2. Haz clic en los tres puntos (⋮) → "Obtener enlace rellenado previamente"
# 3. Llena TODOS los campos con valores de prueba:
#    - Matrícula: TEST-123
#    - Nombre: Juan
#    - Apellido Paterno: García
#    - Apellido Materno: López
#    - Correo: test@ejemplo.com
#    - Teléfono: 5512345678
#    - CURP: GAGL850101HDFRRN09
# 4. Haz clic en "Obtener enlace"
# 5. Copia la URL completa
# 6. La URL tendrá este formato:
#    https://docs.google.com/forms/.../viewform?
#    entry.1877115667=TEST-123&
#    entry.2005620554=Juan&
#    entry.1045781291=García&
#    entry.1065046570=López&
#    entry.1166974658=test@ejemplo.com&
#    entry.839337160=5512345678&
#    entry.2006368554=GAGL850101HDFRRN09
#
# 7. Los números después de "entry." son tus Entry IDs
# 8. Abre lib/api.ts y busca la función generarUrlGoogleForms
# 9. Reemplaza los Entry IDs con los tuyos:
#
#    const entryMap = {
#      nombre: 'entry.2005620554',           // ← Tu entry ID del campo Nombre
#      apellido_paterno: 'entry.1045781291', // ← Tu entry ID del campo Apellido Paterno
#      apellido_materno: 'entry.1065046570', // ← Tu entry ID del campo Apellido Materno
#      correo: 'entry.1166974658',           // ← Tu entry ID del campo Correo
#      telefono: 'entry.839337160',          // ← Tu entry ID del campo Teléfono
#      matricula: 'entry.1877115667',        // ← Tu entry ID del campo Matrícula
#      curp: 'entry.2006368554',             // ← Tu entry ID del campo CURP
#    }
#
# Ver documentación completa en: CONFIGURACION_GOOGLE_FORMS.md


# ==============================================================================
# CONFIGURACIÓN ADICIONAL (OPCIONAL)
# ==============================================================================

# Tiempo de espera para peticiones a la API (en milisegundos)
# Por defecto: 30000 (30 segundos)
# NEXT_PUBLIC_API_TIMEOUT=30000

# Habilitar modo debug (muestra logs adicionales en la consola)
# Por defecto: false
# NEXT_PUBLIC_DEBUG=false
