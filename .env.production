# .env.production

# --------------------------------------------------------
# 1. Variables Públicas (Se queman en el JS del navegador)
# --------------------------------------------------------

# URL del Backend
# Debe ser https://api.midominio.edu.mx o la IP del servidor.
#NEXT_PUBLIC_API_URL=https://api.cuh.edu.mx

# URL de Google Forms (si es la definitiva)
NEXT_PUBLIC_GOOGLE_FORMS_URL=https://docs.google.com/forms/d/e/1FAIpQLScB2672HU6ZUA_HdWEVHGJYOKV8wgIGV7PpvKyWH6aV61ncpg/viewform

# --------------------------------------------------------
# 2. Variables de Servidor (Solo las lee Node.js)
# --------------------------------------------------------

# El puerto donde escuchará Next.js internamente
PORT=3000

# Entorno
NODE_ENV=production